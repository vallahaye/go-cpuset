{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.24.11",
    "bats@1.11.1",
    "goreleaser@2.9.0",
    "golangci-lint@1.64.8",
    "shellcheck@0.10.0"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "lint": [
        "golangci-lint run ./...",
        "git ls-files '*.bats' '*.sh' | xargs shellcheck"
      ],
      "test": [
        "go test -v ./...",
        "bats ./cmd/cpuset"
      ],
      "release": ["goreleaser release"]
    }
  }
}
