{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.24.11",
    "bats@1.12.0",
    "goreleaser@2.13.0",
    "golangci-lint@2.6.2",
    "shellcheck-minimal@0.11.0"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "lint": [
        "golangci-lint run ./...",
        "shellcheck ./cmd/cpuset/main_test.bats"
      ],
      "test": [
        "go test -v ./...",
        "bats ./cmd/cpuset"
      ],
      "release": ["goreleaser release"]
    }
  }
}
